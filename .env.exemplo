# Copie este arquivo, renomeie a cópia para .env e preencha só o que for usar.
# NUNCA compartilhe o arquivo .env com ninguém.

# Voz de IA (elevenlabs.io > Developers > API Keys). Deixe vazio se for gravar a sua voz.
ELEVENLABS_API_KEY=
# ID da voz escolhida na Voice Library (o Claude ajuda a escolher)
ELEVENLABS_VOICE_ID=

# Vídeos e fotos grátis para a edição (as duas são gratuitas)
# pexels.com/api
PEXELS_API_KEY=
# pixabay.com/api/docs
PIXABAY_API_KEY=
